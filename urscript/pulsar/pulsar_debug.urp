<URProgram name="pulsar_debug" installation="default" installationRelativePath="default" createdIn="5.11.11" lastSavedIn="5.11.11">
  <children>
    <MainProgram runOnlyOnce="true" InitVariablesNode="false">
      <children>
        <Script type="File">
          <cachedContents>def Program():

  # ---- settings ----
  ip = "172.22.22.100"
  port = 23

  barrel = 190
  nozzle = 215

  feed = 900
  flow = 100

  retract_mm = 3.0
  retract_feed = 600

  debug_pulsar_ready = True
  pulsar_ready_pin   = 0

  # ---- Duet I/O ----

  def duet_open(iparg, portarg):
    socket_open(iparg, portarg, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line(line):
    socket_send_line(line, "duet")
  end

  # Build "M98 P<quote>filename<quote> params\n" using socket_send_byte
  # for the double quotes. URScript's \" escape isn't honoured by
  # Polyscope 5.11 so we can't embed quotes in a string literal.
  def duet_send_m98(filename, params):
    socket_send_string("M98 P", "duet")
    socket_send_byte(34, "duet")
    socket_send_string(filename, "duet")
    socket_send_byte(34, "duet")
    socket_send_string(params, "duet")
    socket_send_byte(10, "duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # ---- Pulsar ----

  def pulsar_clear_faults():
    duet_send_m98("pulsar_clear_faults.g", "")
    sleep(0.1)
  end

  def pulsar_preheat(b, n):
    duet_send_m98("pulsar_preheat.g", " B" + to_str(b) + " N" + to_str(n))
  end

  def wait_for_ready(dbg, pin):
    if (dbg == False):
      while (get_standard_digital_in(pin) == False):
        sleep(0.5)
      end
    end
  end

  def pulsar_start(f, pct):
    duet_send_m98("pulsar_start.g", " F" + to_str(f) + " R" + to_str(pct))
  end

  def pulsar_flow(v):
    duet_send_m98("pulsar_flow.g", " S" + to_str(v))
  end

  def pulsar_retract(mm, f):
    duet_send_m98("pulsar_retract.g", " S" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_unretract(mm, f):
    duet_send_m98("pulsar_unretract.g", " S" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_stop():
    duet_send_m98("pulsar_stop.g", "")
    duet_send_m98("pulsar_cooldown.g", "")
  end

  def pulsar_show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:" + resp)
  end

  # ---- Execution ----

  popup("1/10  Connect to Duet at " + ip)
  duet_open(ip, port)

  popup("2/10  Handshake (M115)")
  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("WARNING: no response from Duet. Check IP / cable / Duet is on.")
  end

  popup("3/10  Clear heater faults")
  pulsar_clear_faults()

  popup("4/10  Show temps before preheat")
  pulsar_show_temp()

  popup("5/10  Request preheat (async) to barrel=" + to_str(barrel) + " nozzle=" + to_str(nozzle))
  pulsar_preheat(barrel, nozzle)

  popup("6/10  MANUAL HOLD: verify both zones at target in DWC. Click OK to continue.")
  wait_for_ready(debug_pulsar_ready, pulsar_ready_pin)

  popup("7/10  Start extrusion (feed=" + to_str(feed) + " flow=" + to_str(flow) + ")")
  pulsar_start(feed, flow)

  popup("8/10  Layer-change test: flow off, retract")
  pulsar_flow(0)
  pulsar_retract(retract_mm, retract_feed)

  popup("9/10  Resume: unretract, flow on")
  pulsar_unretract(retract_mm, retract_feed)
  pulsar_flow(flow)

  popup("10/10  Shutdown + close socket")
  pulsar_stop()
  duet_close()

  popup("Debug harness complete")

end
Program()
</cachedContents>
          <file>pulsar_debug.script</file>
        </Script>
      </children>
    </MainProgram>
