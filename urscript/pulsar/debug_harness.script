# Pulsar Atom + Duet 3 — UR5 CB3 debug harness
#
# Standalone, fully-formed URScript program. Run directly on the teach pendant
# to exercise every helper end-to-end with popups between each step. Use this
# to validate the workflow before driving it from Grasshopper.
#
# Sequence:
#   1. Open socket          6. Start continuous extrusion
#   2. Handshake (M115)     7. Layer-change test (flow off + retract)
#   3. Clear heater faults  8. Resume (unretract + flow on)
#   4. Show pre-heat temps  9. Shutdown (flow off, motor off, heaters off)
#   5. Preheat both zones  10. Close socket
#
# Notes:
#   - All helpers take explicit parameters. URScript on CB3 does not reliably
#     close over outer-scope variables inside nested function bodies — passing
#     by argument avoids "variable not defined" errors at compile time.
#   - Single-button popups only. Multi-button popup return values are
#     unreliable across CB3 versions.

def Program():

  # ---------------- SETTINGS ----------------

  # network
  ip = "172.22.22.100"
  port = 23

  # temps (deg C)
  zone1 = 190                  # H0  barrel / feed
  zone2 = 215                  # H1  nozzle / metering

  # extrusion
  feed = 900                   # mm/min  feedrate of the long G1 E... move
  flow = 100                   # %       initial M221 multiplier

  # retraction
  retract_mm = 3.0
  retract_feed = 600           # mm/min

  # preheat polling
  preheat_tolerance = 2.0      # degC  exit loop when both zones >= target - this
  preheat_max_polls = 60       # safety cap on the polling loop

  # ---------------- HELPERS ----------------

  def duet_open(ip, port):
    socket_open(ip, port, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line(line):
    socket_send_line(line, "duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # ---------------- PULSAR ----------------

  def pulsar_clear_faults():
    duet_send_line("M562")
    sleep(0.1)
  end

  def pulsar_preheat_material(z1, z2):
    duet_send_line("T0")
    duet_send_line("M104 S" + to_str(z1) + " H0")
    duet_send_line("M104 S" + to_str(z2) + " H1")
    duet_send_line_and_read("M109 S" + to_str(z1) + " H0", 240.0)
    duet_send_line_and_read("M109 S" + to_str(z2) + " H1", 240.0)
  end

  # Parse "T0:" / "T1:" current temp from an M105 response. -1.0 if missing.
  def parse_temp(resp, tag):
    idx = str_find(resp, tag)
    if (idx < 0):
      return -1.0
    end
    start = idx + str_len(tag)
    tail = str_sub(resp, start)
    space_idx = str_find(tail, " ")
    if (space_idx < 0):
      space_idx = str_len(tail)
    end
    num_str = str_sub(tail, 0, space_idx)
    return to_num(num_str)
  end

  # Polled preheat: set M104 targets, then loop M105 with a popup per poll
  # showing both zone temps. Exits when both reach target - tolerance, or
  # after max_polls iterations.
  def pulsar_preheat_material_polled(z1, z2, tol, max_polls):
    duet_send_line("T0")
    sleep(0.1)
    duet_send_line("M104 S" + to_str(z1) + " H0")
    duet_send_line("M104 S" + to_str(z2) + " H1")
    sleep(0.2)

    i = 0
    reached = False
    while ((i < max_polls) and (reached == False)):
      resp = duet_send_line_and_read("M105", 2.0)
      t0 = parse_temp(resp, "T0:")
      t1 = parse_temp(resp, "T1:")

      msg = "Preheat poll " + to_str(i + 1) + "/" + to_str(max_polls) + "\n"
      msg = msg + "Zone 1: " + to_str(t0) + " / " + to_str(z1) + " degC\n"
      msg = msg + "Zone 2: " + to_str(t1) + " / " + to_str(z2) + " degC"
      popup(msg)

      if ((t0 >= (z1 - tol)) and (t1 >= (z2 - tol))):
        reached = True
      end

      i = i + 1
    end
  end

  def pulsar_start(f, pct):
    duet_send_line("M83")
    duet_send_line("G92 E0")
    duet_send_line("M221 S" + to_str(pct))
    duet_send_line("G1 E1000000 F" + to_str(f))
  end

  def pulsar_flow(value):
    duet_send_line("M221 S" + to_str(value))
  end

  def pulsar_retract(mm, f):
    duet_send_line("G1 E-" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_unretract(mm, f):
    duet_send_line("G1 E" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_stop():
    pulsar_flow(0)
    duet_send_line("M84 E")
    duet_send_line("M104 S0 H0")
    duet_send_line("M104 S0 H1")
  end

  def pulsar_show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:\n" + resp)
  end

  # ---------------- EXECUTION ----------------

  popup("1/10  Connect to Duet at " + ip)
  duet_open(ip, port)

  popup("2/10  Handshake (M115)")
  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("WARNING: no response from Duet. Check IP / cable / firmware.")
  end

  popup("3/10  Clear heater faults (M562)")
  pulsar_clear_faults()

  popup("4/10  Show temps before preheat")
  pulsar_show_temp()

  popup("5/10  Polled preheat to " + to_str(zone1) + " / " + to_str(zone2) + " degC  (click through each poll)")
  pulsar_preheat_material_polled(zone1, zone2, preheat_tolerance, preheat_max_polls)

  popup("6/10  Start extrusion  (feed=" + to_str(feed) + " flow=" + to_str(flow) + ")")
  pulsar_start(feed, flow)

  popup("7/10  Layer-change test: flow off, retract")
  pulsar_flow(0)
  pulsar_retract(retract_mm, retract_feed)

  popup("8/10  Resume: unretract, flow on")
  pulsar_unretract(retract_mm, retract_feed)
  pulsar_flow(flow)

  popup("9/10  Shutdown: flow off, motor off, heaters off")
  pulsar_stop()

  popup("10/10  Close socket")
  duet_close()

  popup("Debug harness complete")

end

Program()
