# Pulsar Atom + Duet 3 — UR e-Series debug harness (daemon architecture)
#
# Standalone, fully-formed URScript program. Paste into a Script Code
# node on the pendant (File / multi-line mode). Run once through the
# 12 popup-gated steps to exercise the daemon-based extrusion control
# end-to-end without any motion. This DEBUG harness still does the full
# preheat+purge itself so it can be run cold in one go; the live print
# program does NOT — preheat+purge live in the separate, blocking
# preheat_purge.script that the operator runs once beforehand.
#
# ARCHITECTURE
#   - All extrusion state lives on the Duet (sys/daemon.g + macros).
#   - UR fires Duet macros via M98 over Telnet, and sets Duet globals
#     directly for live control (rate / pause).
#   - The screw is a stepper, so daemon.g keeps it turning by feeding
#     SHORT G1 E chunks. Live rate = `set global.pulsar_feed`; pause =
#     `set global.pulsar_running = false`. Both are immediate meta-
#     commands (no queue lag) and fire-and-forget (no socket read, no
#     UR blocking) — the screw responds within ~1 chunk (~0.3-0.8 s).
#   - Preheat and purge ARE blocking: pulsar_preheat()/pulsar_purge()
#     wait on the socket reply, which the Duet only sends once the
#     macro's internal M116 (at temp) / M400 (purge done) has finished.
#     No polling, no "check DWC yourself" step.
#   - Every popup() call is blocking=True — Polyscope 5's default is
#     NON-blocking, so the shorthand `popup("...")` on its own does not
#     block. This is a common footgun coming from CB3.
#   - Every M98 line goes through duet_send_m98() / duet_send_m98_and_read(),
#     which build the "M98 P<quote>filename<quote> params\n" byte
#     sequence using socket_send_byte(34) for each quote — Polyscope
#     5.11 does not honour \" as an escape inside a string literal.
#
# DUET-SIDE SETUP REQUIRED (see /duet/ in this repo):
#   - Upload `0:/sys/daemon.g` and `0:/sys/pulsar_init.g` from the repo.
#   - Upload every `0:/macros/pulsar_*.g` file (eleven total, incl.
#     pulsar_purge.g). Verify via DWC → Macros tab before running.
#   - Upload `0:/sys/config.g` too — it defines tool 1 (barrel/H0) and
#     tool 2 (nozzle/H1), which pulsar_preheat.g and pulsar_cooldown.g
#     now target directly. Without it, step 5 will error immediately.
#   - Add `M98 P"pulsar_init.g"` to config.g and reboot the Duet.
#     config.g only re-reads at boot, so this step is required even if
#     you've already uploaded it before — reboot after every change.
#   - Block terminators in the Duet macros are dedent-based — RRF 3.6
#     rejects both bare `end` and `endif` with "Bad command: X".

def Program():

  # ---------------- SETTINGS ----------------

  ip = "172.22.22.100"
  port = 23

  # PETG. barrel = H0 ("Top"), nozzle = H1 ("Bottom").
  barrel = 215
  nozzle = 245

  # feed = starting screw speed (mm/min = deposition rate). feed2 is used
  # in the live rate-change step to show it takes effect within ~1 chunk.
  feed  = 600
  feed2 = 350

  # Purge prime (blocking) — mm of E and the feed to push it at.
  purge_mm   = 200
  purge_feed = 300

  # ---------------- HELPERS ----------------

  def duet_open(ip, port):
    socket_open(ip, port, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line(line):
    socket_send_line(line, "duet")
  end

  def duet_send_m98(filename, params):
    socket_send_string("M98 P", "duet")
    socket_send_byte(34, "duet")
    socket_send_string("0:/macros/", "duet")
    socket_send_string(filename, "duet")
    socket_send_byte(34, "duet")
    socket_send_string(params, "duet")
    socket_send_byte(10, "duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # Same as duet_send_m98 but blocks for a reply. RRF only sends "ok"
  # once the whole macro — including any blocking command inside it —
  # has finished. That's how pulsar_preheat() blocks without polling.
  def duet_send_m98_and_read(filename, params, timeout):
    socket_send_string("M98 P", "duet")
    socket_send_byte(34, "duet")
    socket_send_string("0:/macros/", "duet")
    socket_send_string(filename, "duet")
    socket_send_byte(34, "duet")
    socket_send_string(params, "duet")
    socket_send_byte(10, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # ---------------- PULSAR (M98 wrappers) ----------------

  def pulsar_clear_faults():
    duet_send_m98("pulsar_clear_faults.g", "")
    sleep(0.1)
  end

  # Blocks until both zones are at temp (Duet-side M116). 15 min
  # timeout — if that fires, something is actually wrong.
  def pulsar_preheat(b, n):
    resp = duet_send_m98_and_read("pulsar_preheat.g", " B" + to_str(b) + " N" + to_str(n), 900.0)
    if (resp == ""):
      popup("WARNING: preheat timed out waiting for the Duet. Check heaters, thermistors and M570 config.", title="Debug", warning=True, error=False, blocking=True)
    end
    return resp
  end

  # Blocking purge (M400 inside pulsar_purge.g holds the "ok").
  def pulsar_purge(mm, f):
    duet_send_m98_and_read("pulsar_purge.g", " E" + to_str(mm) + " F" + to_str(f), 300.0)
  end

  def pulsar_start(f):
    duet_send_m98("pulsar_start.g", " F" + to_str(f))
  end

  # Live control — set Duet globals directly, fire-and-forget. RRF
  # processes these immediately (meta-commands, not queued motion); the
  # daemon picks them up within ~1 chunk. No socket read, so no blocking.
  def pulsar_set_rate(f):
    duet_send_line("set global.pulsar_feed = " + to_str(f))
  end

  def pulsar_pause():
    duet_send_line("set global.pulsar_running = false")
  end

  def pulsar_resume():
    duet_send_line("set global.pulsar_running = true")
  end

  def pulsar_stop():
    duet_send_m98("pulsar_stop.g", "")
    duet_send_m98("pulsar_cooldown.g", "")
  end

  def pulsar_show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:" + resp, title="Debug", warning=False, error=False, blocking=True)
  end

  # ---------------- EXECUTION ----------------

  popup("1/12  Connect to Duet at " + ip, title="Debug", warning=False, error=False, blocking=True)
  duet_open(ip, port)

  popup("2/12  Handshake (M115)", title="Debug", warning=False, error=False, blocking=True)
  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("WARNING: no response from Duet. Check IP / cable / firmware.", title="Debug", warning=True, error=False, blocking=True)
  end

  popup("3/12  Clear heater faults", title="Debug", warning=False, error=False, blocking=True)
  pulsar_clear_faults()

  popup("4/12  Show temps before preheat", title="Debug", warning=False, error=False, blocking=True)
  pulsar_show_temp()

  popup("5/12  Preheat (BLOCKING) to barrel=" + to_str(barrel) + " nozzle=" + to_str(nozzle) + ". This can take several minutes from cold — the next popup won't appear until the Duet confirms both zones are at temp.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_preheat(barrel, nozzle)

  popup("6/12  Preheat complete — reported temps:", title="Debug", warning=False, error=False, blocking=True)
  pulsar_show_temp()

  popup("7/12  Purge (BLOCKING): " + to_str(purge_mm) + " mm at F" + to_str(purge_feed) + ". Waits until the move completes. Watch for clean flow.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_purge(purge_mm, purge_feed)

  popup("8/12  Start extrusion — daemon feeds short chunks (feed=" + to_str(feed) + "). Screw should turn continuously.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_start(feed)

  popup("9/12  Live rate change to feed=" + to_str(feed2) + ". Watch the screw slow within ~1 chunk — no wait for a long move to drain.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_set_rate(feed2)

  popup("10/12  Pause test: screw should stop within ~1 chunk. Click OK to resume.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_pause()
  popup("10/12  (paused) Click OK to resume the screw.", title="Debug", warning=False, error=False, blocking=True)
  pulsar_resume()

  popup("11/12  Shutdown: stop daemon, cool down", title="Debug", warning=False, error=False, blocking=True)
  pulsar_stop()

  popup("12/12  Close socket", title="Debug", warning=False, error=False, blocking=True)
  duet_close()

  popup("Debug harness complete", title="Debug", warning=False, error=False, blocking=True)

end

Program()
