# Pulsar Atom + Duet 3 — UR5 CB3 debug harness
#
# Standalone, fully-formed URScript program. Run directly on the teach pendant
# to exercise every helper end-to-end with popups between each step. Use this
# to validate the workflow before driving it from Grasshopper.
#
# Sequence:
#   1. Open socket          6. Start continuous extrusion
#   2. Handshake (M115)     7. Layer-change test (flow off + retract)
#   3. Clear heater faults  8. Resume (unretract + flow on)
#   4. Show pre-heat temps  9. Shutdown (flow off, motor off, heaters off)
#   5. Preheat both zones  10. Close socket
#
# Single-button popups only — multi-button return values are unreliable on CB3.

def Program():

  # ---------------- SETTINGS ----------------

  # network
  ip = "172.22.22.100"
  port = 23

  # temps (deg C)
  zone1 = 190                  # H0  barrel / feed
  zone2 = 215                  # H1  nozzle / metering

  # extrusion
  feed = 900                   # mm/min  feedrate of the long G1 E... move
  flow = 100                   # %       initial M221 multiplier

  # retraction
  retract_mm = 3.0
  retract_feed = 600           # mm/min

  # ---------------- HELPERS ----------------

  def duet_open(ip, port):
    socket_open(ip, port, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line(line):
    socket_send_line(line, "duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # ---------------- PULSAR ----------------

  def pulsar_clear_faults():
    duet_send_line("M562")
    sleep(0.1)
  end

  def pulsar_preheat():
    duet_send_line("T0")
    duet_send_line("M104 S" + to_str(zone1) + " H0")
    duet_send_line("M104 S" + to_str(zone2) + " H1")
    duet_send_line_and_read("M109 S" + to_str(zone1) + " H0", 240.0)
    duet_send_line_and_read("M109 S" + to_str(zone2) + " H1", 240.0)
  end

  def pulsar_start():
    duet_send_line("M83")
    duet_send_line("G92 E0")
    duet_send_line("M221 S" + to_str(flow))
    duet_send_line("G1 E1000000 F" + to_str(feed))
  end

  def pulsar_flow(value):
    duet_send_line("M221 S" + to_str(value))
  end

  def pulsar_retract():
    duet_send_line("G1 E-" + to_str(retract_mm) + " F" + to_str(retract_feed))
  end

  def pulsar_unretract():
    duet_send_line("G1 E" + to_str(retract_mm) + " F" + to_str(retract_feed))
  end

  def pulsar_stop():
    pulsar_flow(0)
    duet_send_line("M84 E")
    duet_send_line("M104 S0 H0")
    duet_send_line("M104 S0 H1")
  end

  def pulsar_show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:\n" + resp)
  end

  # ---------------- EXECUTION ----------------

  popup("1/10  Connect to Duet at " + ip)
  duet_open(ip, port)

  popup("2/10  Handshake (M115)")
  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("WARNING: no response from Duet. Check IP / cable / firmware.")
  end

  popup("3/10  Clear heater faults (M562)")
  pulsar_clear_faults()

  popup("4/10  Show temps before preheat")
  pulsar_show_temp()

  popup("5/10  Preheat to " + to_str(zone1) + " / " + to_str(zone2) + " degC")
  pulsar_preheat()

  popup("6/10  Start extrusion  (feed=" + to_str(feed) + " flow=" + to_str(flow) + ")")
  pulsar_start()

  popup("7/10  Layer-change test: flow off, retract")
  pulsar_flow(0)
  pulsar_retract()

  popup("8/10  Resume: unretract, flow on")
  pulsar_unretract()
  pulsar_flow(flow)

  popup("9/10  Shutdown: flow off, motor off, heaters off")
  pulsar_stop()

  popup("10/10  Close socket")
  duet_close()

  popup("Debug harness complete")

end

Program()
