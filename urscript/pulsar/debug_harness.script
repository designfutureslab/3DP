# Pulsar Atom + Duet 3 — UR5 CB3 debug harness (daemon + DIO gate)
#
# Standalone, fully-formed URScript program. Run directly on the teach
# pendant to exercise the daemon-based extrusion control end-to-end with
# popups between each step. Use this to validate the workflow before
# driving it from Grasshopper.
#
# Architecture:
#   - All extrusion state lives on the Duet (sys/daemon.g + macros).
#   - UR fires Duet macros via M98 over Telnet.
#   - UR waits for the Duet's "ready" signal via a hardware DIO line
#     (the Duet asserts an output when M116 completes; the UR reads it).
#   - Until the wire is in place, debug_mode=True turns the wait into an
#     operator-confirmation popup.
#
# IMPORTANT — Duet-side setup required before running:
#   - Upload `0:/sys/daemon.g`, `0:/sys/pulsar_init.g`, and the
#     `0:/macros/pulsar_*.g` macros from this repo's /duet/ folder.
#   - Add `M98 P"pulsar_init.g"` to config.g and reboot the Duet.
#
# IMPORTANT — Polyscope: set the program to "Run once". Continuous loop
# mode will re-fire M98 P"pulsar_start.g" every few seconds.
#
# Sequence:
#   1. Open socket          7. Start extrusion (daemon takes over)
#   2. Handshake (M115)     8. Layer-change test
#   3. Clear heater faults  9. Resume (unretract + flow on)
#   4. Show pre-heat temps 10. Shutdown (stop daemon, cooldown)
#   5. Preheat (async)     11. Close socket
#   6. Manual hold / DIO gate

def Program():

  # ---------------- SETTINGS ----------------

  # network
  ip = "172.22.22.100"
  port = 23

  # temps (deg C) — PLA values. PETG: try barrel=220, nozzle=245.
  barrel = 190
  nozzle = 215

  # extrusion
  feed = 900                   # mm/min  — screw rate (chunks are F'd at this)
  flow = 100                   # %       — initial M221 multiplier

  # retraction
  retract_mm = 3.0
  retract_feed = 600           # mm/min

  # ready signal
  # debug_mode=True  → operator popup ("click OK when heaters are at temp")
  # debug_mode=False → poll standard digital input `ready_pin` until high
  debug_mode = True
  ready_pin = 0                # UR standard digital input wired to Duet DIO

  # ---------------- HELPERS ----------------

  def duet_open(ip, port):
    socket_open(ip, port, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line(line):
    socket_send_line(line, "duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  # ---------------- PULSAR (M98 wrappers) ----------------

  def pulsar_clear_faults():
    duet_send_line("M98 P\"pulsar_clear_faults.g\"")
    sleep(0.1)
  end

  # Fire-and-forget — Duet handles the M116 wait, then asserts ready DIO.
  def pulsar_preheat(b, n):
    cmd = "M98 P\"pulsar_preheat.g\" B" + to_str(b) + " N" + to_str(n)
    duet_send_line(cmd)
  end

  def pulsar_start(f, pct):
    cmd = "M98 P\"pulsar_start.g\" F" + to_str(f) + " R" + to_str(pct)
    duet_send_line(cmd)
  end

  def pulsar_flow(value):
    duet_send_line("M98 P\"pulsar_flow.g\" S" + to_str(value))
  end

  def pulsar_retract(mm, f):
    duet_send_line("M98 P\"pulsar_retract.g\" S" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_unretract(mm, f):
    duet_send_line("M98 P\"pulsar_unretract.g\" S" + to_str(mm) + " F" + to_str(f))
  end

  def pulsar_stop():
    duet_send_line("M98 P\"pulsar_stop.g\"")
    duet_send_line("M98 P\"pulsar_cooldown.g\"")
  end

  def pulsar_show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:\n" + resp)
  end

  # ---------- ready-signal gates ----------

  def wait_for_ready(dbg, pin):
    if (dbg == False):
      while (get_standard_digital_in(pin) == False):
        sleep(0.5)
      end
    end
  end

  # ---------------- EXECUTION ----------------

  popup("1/11  Connect to Duet at " + ip)
  duet_open(ip, port)

  popup("2/11  Handshake (M115)")
  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("WARNING: no response from Duet. Check IP / cable / firmware.")
  end

  popup("3/11  Clear heater faults")
  pulsar_clear_faults()

  popup("4/11  Show temps before preheat")
  pulsar_show_temp()

  popup("5/11  Request preheat (async) to barrel=" + to_str(barrel) + " nozzle=" + to_str(nozzle))
  pulsar_preheat(barrel, nozzle)

  popup("6/11  MANUAL HOLD: verify both zones at target in DWC. Click OK to start the print.")
  wait_for_ready(debug_mode, ready_pin)

  popup("7/11  Start extrusion — daemon takes over (feed=" + to_str(feed) + " flow=" + to_str(flow) + ")")
  pulsar_start(feed, flow)

  popup("8/11  Layer-change test: flow off, retract")
  pulsar_flow(0)
  pulsar_retract(retract_mm, retract_feed)

  popup("9/11  Resume: unretract, flow on")
  pulsar_unretract(retract_mm, retract_feed)
  pulsar_flow(flow)

  popup("10/11  Shutdown: stop daemon, cool down")
  pulsar_stop()

  popup("11/11  Close socket")
  duet_close()

  popup("Debug harness complete")

end

Program()
