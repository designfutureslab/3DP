# Pulsar Stop — wind down the extruder, leave the robot to move home.
#
# Paste after the last bead movej, BEFORE any return-home travel. Flow
# stops first so no material extrudes during the home move even if a
# queued chunk is still draining. No popup here — the operator gate
# lives in the Pulsar End block that fires after the robot has parked.

pulsar_flow_off()
pulsar_retract(3.0, 600)
pulsar_stop_extrusion()
pulsar_cooldown()
