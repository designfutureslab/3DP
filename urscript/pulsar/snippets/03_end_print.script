# Pulsar end — stop, cool, operator popup, close socket
#
# This is the "Pulsar End" command code. Paste after the last bead
# movej, before any return-home travel. Flow stops first so no material
# extrudes if a queued chunk is still draining; the popup blocks until
# the operator clicks OK; the socket closes; then GH's return-home
# movej runs normally.

pulsar_flow_off()
pulsar_retract(3.0, 600)
pulsar_stop_extrusion()
pulsar_cooldown()

popup("Job Complete!", title="Job_Done", warning=False, error=False, blocking=True)

duet_close()
