def Program():

  ip = "172.22.22.100"
  port = 23

  barrel = [Barrell]
  nozzle = [Nozzle]

  def duet_open(ip, port):
    socket_open(ip, port, "duet")
    sleep(0.2)
  end

  def duet_close():
    socket_close("duet")
  end

  def duet_send_line_and_read(line, timeout):
    socket_send_line(line, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  def duet_send_m98(filename, params):
    socket_send_string("M98 P", "duet")
    socket_send_byte(34, "duet")
    socket_send_string("0:/macros/", "duet")
    socket_send_string(filename, "duet")
    socket_send_byte(34, "duet")
    socket_send_string(params, "duet")
    socket_send_byte(10, "duet")
  end

  def duet_send_m98_and_read(filename, params, timeout):
    socket_send_string("M98 P", "duet")
    socket_send_byte(34, "duet")
    socket_send_string("0:/macros/", "duet")
    socket_send_string(filename, "duet")
    socket_send_byte(34, "duet")
    socket_send_string(params, "duet")
    socket_send_byte(10, "duet")
    sleep(0.05)
    resp = socket_read_string("duet", "", "", False, timeout)
    return resp
  end

  def show_temp():
    resp = duet_send_line_and_read("M105", 2.0)
    popup("Temp:" + resp, title="Preheat", warning=False, error=False, blocking=True)
  end

  duet_open(ip, port)

  resp = duet_send_line_and_read("M115", 2.0)
  if (resp == ""):
    popup("ERROR: no response from Duet. Check IP / cable / firmware.", title="Fatal", warning=False, error=True, blocking=True)
    halt
  end

  duet_send_m98("pulsar_clear_faults.g", "")
  sleep(0.1)

  popup("Preheating to barrel=" + to_str(barrel) + " nozzle=" + to_str(nozzle) + ". Several minutes from cold - the next popup will not appear until the Duet confirms both zones are at temp.", title="Preheat", warning=False, error=False, blocking=True)
  resp = duet_send_m98_and_read("pulsar_preheat.g", " B" + to_str(barrel) + " N" + to_str(nozzle), 900.0)
  if (resp == ""):
    popup("WARNING: preheat timed out. Check heaters, thermistors, M570.", title="Preheat", warning=True, error=False, blocking=True)
  end

  show_temp()

  duet_close()

  popup("Ready. Barrel/nozzle at temp. You can ignore this file for your next print if the heaters are still hot.", title="Preheat", warning=False, error=False, blocking=True)

end
Program()
