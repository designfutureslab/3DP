
# Pulsar Atom + Duet 3 helper library for UR5 CB3 (URScript / Polyscope 3.x)
#
# This file is the function library only. It contains no top-level execution.
# Use it one of two ways:
#   1. Paste the function defs inside a `def Program(): ... end` block on the
#      teach pendant, then call them in the order you want.
#   2. Have Grasshopper emit a full program that inlines these defs verbatim
#      followed by the print's motion + flow commands.
#
# Communication model:
#   - One named TCP socket: "duet" (port 23 / Telnet).
#   - All extruder state is changed by sending one G-code line per call.
#   - Duet returns plain-text responses; we only read them when we need to
#     gate on something (preheat wait, handshake, temp readback).
#
# Control model:
#   - Continuous extrusion: a single very long `G1 E... F...` keeps the screw
#     turning until M84 E or end-of-job.
#   - Flow modulation: `M221 S<percent>` per layer / per section.
#   - Retraction: relative-E moves (`M83`, then `G1 E-x` / `G1 E+x`).
#   - No real-time sync between UR motion and the extruder. Everything is a
#     state change, not a per-segment instruction.

# ---------- low-level Duet I/O ----------

def duet_open(ip, port):
  socket_open(ip, port, "duet")
  sleep(0.2)
end

def duet_close():
  socket_close("duet")
end

def duet_send_line(line):
  socket_send_line(line, "duet")
end

# Send + small settle + read. Returns "" on timeout.
def duet_send_line_and_read(line, timeout):
  socket_send_line(line, "duet")
  sleep(0.05)
  resp = socket_read_string("duet", "", "", False, timeout)
  return resp
end

# socket_open's return value is unreliable on CB3, so we verify connectivity
# by sending M115 and checking that any response came back.
def duet_handshake(timeout):
  resp = duet_send_line_and_read("M115", timeout)
  if (resp != ""):
    return True
  end
  return False
end

# ---------- Pulsar high-level functions ----------

def pulsar_clear_heater_faults():
  duet_send_line("M562")
  sleep(0.1)
end

# zone1 = barrel/feed   (heater H0)
# zone2 = nozzle/meter  (heater H1)
# Blocks until both setpoints are reached (M109 is a blocking wait on Duet).
def pulsar_preheat_pla(zone1, zone2):
  duet_send_line("T0")
  sleep(0.1)
  duet_send_line("M104 S" + to_str(zone1) + " H0")
  duet_send_line("M104 S" + to_str(zone2) + " H1")
  sleep(0.1)
  duet_send_line_and_read("M109 S" + to_str(zone1) + " H0", 240.0)
  duet_send_line_and_read("M109 S" + to_str(zone2) + " H1", 240.0)
end

# Begin continuous extrusion. After this returns, the screw is turning.
# `feed` is the F-value (mm/min) for the long G1 — i.e. screw rate, NOT
# UR motion speed. `flow` is the starting M221 multiplier in percent.
def pulsar_start_extrusion(feed, flow):
  duet_send_line("M83")
  duet_send_line("G92 E0")
  duet_send_line("M221 S" + to_str(flow))
  duet_send_line("G1 E1000000 F" + to_str(feed))
end

def pulsar_flow_on(flow):
  duet_send_line("M221 S" + to_str(flow))
end

def pulsar_flow_off():
  duet_send_line("M221 S0")
end

# Use after pulsar_flow_off() and before a UR travel move.
def pulsar_retract(mm, feed):
  duet_send_line("G1 E-" + to_str(mm) + " F" + to_str(feed))
end

def pulsar_unretract(mm, feed):
  duet_send_line("G1 E" + to_str(mm) + " F" + to_str(feed))
end

# Stop the screw cleanly. Heaters stay on.
def pulsar_stop_extrusion():
  pulsar_flow_off()
  duet_send_line("M84 E")
end

def pulsar_cooldown():
  duet_send_line("M104 S0 H0")
  duet_send_line("M104 S0 H1")
end

# Pop up the current M105 reading. Diagnostic helper.
def pulsar_show_temp():
  resp = duet_send_line_and_read("M105", 2.0)
  popup("Temp:\n" + resp)
end
