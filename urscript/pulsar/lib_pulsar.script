
# Pulsar Atom + Duet 3 helper library (v3 low-latency, rate-only)
#
# ONE live knob: pulsar_set_rate(feed). Screw speed IS deposition rate on
# a single-screw pellet extruder — there is no flow-%, no retract (inert
# on a screw; stopping the screw is what breaks the bead), no M221.
#
# LATENCY MODEL
#   - Duet daemon feeds time-sized chunks (~pulsar_latency s each,
#     default 0.25 s) with no dwell → continuous rotation.
#   - pulsar_set_rate / pulsar_pause / pulsar_resume are fire-and-forget
#     `set global...` Telnet lines — RRF applies them immediately (meta-
#     commands), daemon re-reads within ~1 chunk. End-to-end ≈ 0.3-1 s.
#   - UR PAUSE and E-STOP are handled in HARDWARE, not here: a UR digital
#     output configured "high while program running" wires to Duet io1.in
#     and gates the daemon directly. Nothing to call — pausing the robot
#     stops the screw within ~1 chunk even if URScript is frozen.
#
# QUOTES: Polyscope 5.11 doesn't honour \" inside string literals, so
# every M98 line is built byte-wise via socket_send_byte(34) for the
# quote characters (duet_send_m98 / duet_send_m98_and_read).
#
# Duet-side setup: see /duet/README.md (daemon.g v3 + pulsar_init.g v3 +
# macros; M950 J0 input; pulsar_hw_gate flag once the UR wire is in).

# ---------- low-level Duet I/O ----------

def duet_open(ip, port):
  socket_open(ip, port, "duet")
  sleep(0.2)
end

def duet_close():
  socket_close("duet")
end

def duet_send_line(line):
  socket_send_line(line, "duet")
end

def duet_send_m98(filename, params):
  socket_send_string("M98 P", "duet")
  socket_send_byte(34, "duet")
  socket_send_string("0:/macros/", "duet")
  socket_send_string(filename, "duet")
  socket_send_byte(34, "duet")
  socket_send_string(params, "duet")
  socket_send_byte(10, "duet")
end

def duet_send_line_and_read(line, timeout):
  socket_send_line(line, "duet")
  sleep(0.05)
  resp = socket_read_string("duet", "", "", False, timeout)
  return resp
end

# Blocking M98 — RRF sends "ok" only after the whole macro (incl. M116 /
# M400 inside it) finishes. How preheat/purge block without polling.
def duet_send_m98_and_read(filename, params, timeout):
  socket_send_string("M98 P", "duet")
  socket_send_byte(34, "duet")
  socket_send_string("0:/macros/", "duet")
  socket_send_string(filename, "duet")
  socket_send_byte(34, "duet")
  socket_send_string(params, "duet")
  socket_send_byte(10, "duet")
  sleep(0.05)
  resp = socket_read_string("duet", "", "", False, timeout)
  return resp
end

def duet_handshake(timeout):
  resp = duet_send_line_and_read("M115", timeout)
  if (resp != ""):
    return True
  end
  return False
end

# ---------- Pulsar: setup / teardown (not latency-sensitive) ----------

def pulsar_clear_heater_faults():
  duet_send_m98("pulsar_clear_faults.g", "")
  sleep(0.1)
end

# Blocking preheat (Duet-side M116). Run from preheat_purge.script, not
# the live print program.
def pulsar_preheat(barrel, nozzle):
  resp = duet_send_m98_and_read("pulsar_preheat.g", " B" + to_str(barrel) + " N" + to_str(nozzle), 900.0)
  if (resp == ""):
    popup("WARNING: preheat timed out. Check heaters/thermistors.", title="Pulsar", warning=True, error=False, blocking=True)
  end
  return resp
end

# Blocking purge/prime (Duet-side M400).
def pulsar_purge(mm, feed):
  duet_send_m98_and_read("pulsar_purge.g", " E" + to_str(mm) + " F" + to_str(feed), 300.0)
end

def pulsar_show_temp():
  resp = duet_send_line_and_read("M105", 2.0)
  popup("Temp:" + resp, title="Pulsar", warning=False, error=False, blocking=True)
end

# Clean-slate start (Duet macro drains + resets before starting).
def pulsar_start_extrusion(feed):
  duet_send_m98("pulsar_start.g", " F" + to_str(feed))
end

# Stop + drain + motor off (heaters stay on; add pulsar_cooldown after).
def pulsar_stop_extrusion():
  duet_send_m98("pulsar_stop.g", "")
end

def pulsar_cooldown():
  duet_send_m98("pulsar_cooldown.g", "")
end

# ---------- Pulsar: LIVE control (the fast path) ----------
# Fire-and-forget meta-commands. No socket read, no blocking, applied by
# the daemon within ~pulsar_latency seconds.

def pulsar_set_rate(feed):
  duet_send_line("set global.pulsar_feed = " + to_str(feed))
end

def pulsar_pause():
  duet_send_line("set global.pulsar_running = false")
end

def pulsar_resume():
  duet_send_line("set global.pulsar_running = true")
end
